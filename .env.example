# === Django / Postgres ===
# Opción A (recomendada): URI de Supabase
# Dashboard → Project Settings → Database → Connection string → URI
# - Migraciones / manage.py: Connection pooling → Session mode (puerto 5432)
#   o Direct connection
# - App en producción: Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# IMPORTANTE: Genera una clave segura para producción usando: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-en-produccion-usa-una-clave-segura
DEBUG=True
DJANGO_ENV=development
# En desarrollo: localhost,127.0.0.1. En producción: especifica tus dominios separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# === Frontend → Backend Django ===
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# === Supabase (Auth / Storage / client JS) ===
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Solo servidor / scripts. NUNCA en el navegador ni en commits.
SUPABASE_SERVICE_ROLE_KEY=

# === Integraciones existentes (opcionales) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_ID=
# Telegram / notificaciones automáticas
TELEGRAM_WEBHOOK_SECRET=
# true = enviar avisos automáticos todos los días (3 días antes / 2 días después del pago)
NOTIFICACIONES_AUTO_ENABLED=false
# Hora de envío (0-23, hora de Ecuador)
NOTIFICACIONES_HORA=9
